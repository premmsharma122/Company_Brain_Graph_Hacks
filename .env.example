# --- FalkorDB (local Docker defaults) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
GRAPH_NAME=orgmind
# --- API ---
CORS_ORIGINS=http://localhost:5173
# --- LLM (optional: everything works without it via rule-based routing and template answers) ---
# LLM_PROVIDER=auto | gemini | groq | none
LLM_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
# Override if the default model names are retired on the free tier
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
